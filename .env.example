# =============================================================================
# Raspberry Pi Kiosk Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git!

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# Required: Kiosk user password (used for login and VNC access)
KIOSK_PASSWORD=your_secure_password_here

# =============================================================================
# HOME ASSISTANT CONNECTION
# =============================================================================
# Home Assistant dashboard URL to display in kiosk mode
# Default: http://192.168.1.5:8123/lovelace/0
KIOSK_URL=http://192.168.1.5:8123/lovelace/0

# Home Assistant IP address for network health checks
# Default: 192.168.1.5
HOME_ASSISTANT_IP=192.168.1.5

# =============================================================================
# KIOSK DISPLAY SETTINGS
# =============================================================================
# Keyboard layout code for on-screen keyboard
# Common layouts: us, uk, fr, de, es, it, nl, be
# Default: be (Belgian French)
KEYBOARD_LAYOUT=be

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================
# WiFi credentials (leave as YOUR_WIFI_SSID to use Ethernet only)
WIFI_SSID=your_wifi_network_name
WIFI_PASSWORD=your_wifi_password

# =============================================================================
# MQTT MONITORING (Optional)
# =============================================================================
# Enable Raspberry Pi MQTT Monitor for system metrics
# Set to 'true' to publish CPU, memory, disk, temp to Home Assistant
# Default: false
ENABLE_RPI_MONITOR=false

# MQTT broker configuration (usually your Home Assistant IP)
MQTT_BROKER=192.168.1.5
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# MQTT topic configuration
MQTT_TOPIC_PREFIX=homeassistant
MQTT_DEVICE_ID=keuken
MQTT_CHECK_INTERVAL=60

# =============================================================================
# GITHUB ACTIONS RUNNER (Optional)
# =============================================================================
# Self-hosted GitHub Actions runner configuration
# Leave empty to skip runner installation
GITHUB_RUNNER_TOKEN=
GITHUB_REPO=
